<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoClicker" Width="470" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Background="#17171B" Foreground="#EDEDF0"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">

  <Window.Resources>
    <!-- Palette -->
    <SolidColorBrush x:Key="CardBg" Color="#212127"/>
    <SolidColorBrush x:Key="CardBorder" Color="#2C2C34"/>
    <SolidColorBrush x:Key="Input" Color="#2A2A32"/>
    <SolidColorBrush x:Key="InputBorder" Color="#3A3A45"/>
    <SolidColorBrush x:Key="Hover" Color="#34343E"/>
    <SolidColorBrush x:Key="Text" Color="#EDEDF0"/>
    <SolidColorBrush x:Key="SubText" Color="#9898A6"/>
    <SolidColorBrush x:Key="Accent" Color="#5B7CFF"/>
    <SolidColorBrush x:Key="Danger" Color="#EE4F5A"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Cards & text -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBg}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,12,16,13"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource SubText}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="Unit" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{StaticResource SubText}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource SubText}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>
    <Style x:Key="KeyBadge" TargetType="Border">
      <Setter Property="Background" Value="#30FFFFFF"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding" Value="6,1"/>
      <Setter Property="Margin" Value="10,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Segmented control -->
    <Style x:Key="SegmentHost" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Input}"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="3"/>
    </Style>
    <Style x:Key="Segment" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource SubText}"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.FontWeight="SemiBold"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Hover}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Tab" TargetType="RadioButton" BasedOn="{StaticResource Segment}">
      <Setter Property="Padding" Value="8,8"/>
      <Setter Property="GroupName" Value="tabs"/>
    </Style>

    <!-- Number box -->
    <Style x:Key="NumBox" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource Input}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
      <Setter Property="CaretBrush" Value="White"/>
      <Setter Property="SelectionBrush" Value="{StaticResource Accent}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="9">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Margin="6,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#4C4C5A"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Buttons: one template, a light overlay for hover / dark for pressed -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Input}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10"/>
              <Border x:Name="ov" Background="White" Opacity="0" CornerRadius="10"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ov" Property="Opacity" Value="0.08"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ov" Property="Background" Value="Black"/>
                <Setter TargetName="ov" Property="Opacity" Value="0.15"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.35"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6A88FF" Offset="0"/>
            <GradientStop Color="#4F6CF0" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F4646E" Offset="0"/>
            <GradientStop Color="#DD4250" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="KeyChip" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="BorderBrush" Value="{StaticResource InputBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <!-- Toggle switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Border x:Name="track" Grid.Column="1" Width="40" Height="22" CornerRadius="11"
                      Background="{StaticResource Input}" BorderBrush="#555563" BorderThickness="1">
                <Ellipse x:Name="thumb" Width="12" Height="12" Fill="#B9B9C6" HorizontalAlignment="Left" Margin="5,0"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{StaticResource Accent}"/>
                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="thumb" Property="Fill" Value="White"/>
                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="thumb" Property="Width" Value="14"/>
                <Setter TargetName="thumb" Property="Height" Value="14"/>
                <Setter TargetName="thumb" Property="Margin" Value="4,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Slim scrollbar -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Margin="0,4,3,4">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="3" Background="#4C4C5A" Width="6"/>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Macro list -->
    <Style x:Key="MacroListStyle" TargetType="ListBox">
      <Setter Property="Background" Value="{StaticResource Input}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="4">
              <ScrollViewer Focusable="False">
                <ItemsPresenter/>
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                  <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="8,5">
                    <ContentPresenter/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="#32323C"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="#3A3A47"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="ItemTemplate">
        <Setter.Value>
          <DataTemplate>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="70"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="{Binding Index}" Foreground="#6E6E7C"/>
              <TextBlock Grid.Column="1" Text="{Binding Action}"/>
              <TextBlock Grid.Column="2" Text="{Binding Position}" Foreground="{StaticResource SubText}"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
              <TextBlock Grid.Column="3" Text="{Binding Delay}" Foreground="{StaticResource SubText}"
                         TextAlignment="Right" FontSize="12"/>
            </Grid>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="16,10,16,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Margin="2,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Image x:Name="Logo" Width="46" Height="46" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="AutoClicker" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Text="Clics automáticos, grabación y reproducción" FontSize="12" Foreground="{StaticResource SubText}"/>
      </StackPanel>
    </Grid>

    <!-- Tabs -->
    <Border Grid.Row="1" Style="{StaticResource SegmentHost}" Margin="0,0,0,12">
      <UniformGrid Rows="1">
        <RadioButton x:Name="TabClicker" Style="{StaticResource Tab}" IsChecked="True">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE962;" Style="{StaticResource Glyph}" FontSize="13"/>
            <TextBlock Text="Clicker"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="TabMacro" Style="{StaticResource Tab}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE7C8;" Style="{StaticResource Glyph}" FontSize="13"/>
            <TextBlock Text="Grabación"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="TabSettings" Style="{StaticResource Tab}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE713;" Style="{StaticResource Glyph}" FontSize="13"/>
            <TextBlock Text="Ajustes"/>
          </StackPanel>
        </RadioButton>
      </UniformGrid>
    </Border>

    <!-- Pages (Hidden, not Collapsed, so the window keeps one height) -->
    <Grid Grid.Row="2">

      <!-- ═════════ Clicker ═════════ -->
      <StackPanel x:Name="PanelClicker">
        <StackPanel x:Name="ClickerOptions">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="INTERVALO ENTRE CLICS" Style="{StaticResource Caption}"/>
              <UniformGrid Columns="4">
                <StackPanel Margin="0,0,8,0">
                  <TextBox x:Name="TxtHours" Style="{StaticResource NumBox}"/>
                  <TextBlock Text="horas" Style="{StaticResource Unit}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                  <TextBox x:Name="TxtMinutes" Style="{StaticResource NumBox}"/>
                  <TextBlock Text="minutos" Style="{StaticResource Unit}"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0">
                  <TextBox x:Name="TxtSeconds" Style="{StaticResource NumBox}"/>
                  <TextBlock Text="segundos" Style="{StaticResource Unit}"/>
                </StackPanel>
                <StackPanel>
                  <TextBox x:Name="TxtMs" Style="{StaticResource NumBox}"/>
                  <TextBlock Text="milisegundos" Style="{StaticResource Unit}"/>
                </StackPanel>
              </UniformGrid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Botón" Style="{StaticResource FieldLabel}"/>
              <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="RbLeft" GroupName="mb" Content="Izquierdo" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="RbRight" GroupName="mb" Content="Derecho" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="RbMiddle" GroupName="mb" Content="Central" Style="{StaticResource Segment}"/>
                </UniformGrid>
              </Border>
              <TextBlock Grid.Row="2" Text="Tipo" Style="{StaticResource FieldLabel}"/>
              <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SegmentHost}">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="RbSingle" GroupName="ct" Content="Simple" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="RbDouble" GroupName="ct" Content="Doble" Style="{StaticResource Segment}"/>
                </UniformGrid>
              </Border>
            </Grid>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="REPETICIÓN" Style="{StaticResource Caption}"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource SegmentHost}">
                  <UniformGrid Rows="1">
                    <RadioButton x:Name="RbForever" GroupName="rep" Content="Hasta detener" Style="{StaticResource Segment}"/>
                    <RadioButton x:Name="RbCount" GroupName="rep" Content="Nº de veces" Style="{StaticResource Segment}"/>
                  </UniformGrid>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                  <TextBox x:Name="TxtRepeat" Style="{StaticResource NumBox}" Width="90"/>
                  <TextBlock Text="veces" Style="{StaticResource FieldLabel}" Margin="8,0,0,0"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="POSICIÓN DEL CURSOR" Style="{StaticResource Caption}"/>
              <Border Style="{StaticResource SegmentHost}">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="RbCurrent" GroupName="pos" Content="Donde esté el cursor" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="RbFixed" GroupName="pos" Content="Punto fijo" Style="{StaticResource Segment}"/>
                </UniformGrid>
              </Border>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="80"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="X" Style="{StaticResource FieldLabel}" Margin="2,0,8,0"/>
                <TextBox x:Name="TxtX" Grid.Column="1" Style="{StaticResource NumBox}"/>
                <TextBlock Grid.Column="2" Text="Y" Style="{StaticResource FieldLabel}" Margin="12,0,8,0"/>
                <TextBox x:Name="TxtY" Grid.Column="3" Style="{StaticResource NumBox}"/>
                <Button x:Name="BtnPick" Grid.Column="4" Style="{StaticResource Btn}" Margin="12,0,0,0" Height="38">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE81D;" Style="{StaticResource Glyph}"/>
                    <TextBlock Text="Elegir en pantalla"/>
                  </StackPanel>
                </Button>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <Grid Margin="0,2,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BtnStart" Style="{StaticResource PrimaryBtn}" Height="48">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Iniciar"/>
              <Border Style="{StaticResource KeyBadge}">
                <TextBlock x:Name="StartKey" FontSize="11"/>
              </Border>
            </StackPanel>
          </Button>
          <Button x:Name="BtnStop" Grid.Column="2" Style="{StaticResource DangerBtn}" Height="48">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE71A;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Detener"/>
              <Border Style="{StaticResource KeyBadge}">
                <TextBlock x:Name="StopKey" FontSize="11"/>
              </Border>
            </StackPanel>
          </Button>
        </Grid>
      </StackPanel>

      <!-- ═════════ Record & playback ═════════ -->
      <StackPanel x:Name="PanelMacro" Visibility="Hidden">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Margin="0,-4,0,8">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="CLICS GRABADOS" Style="{StaticResource Caption}" Margin="0"/>
                <TextBlock x:Name="MacroSummary" FontSize="11" Margin="10,0,0,0" Foreground="#6E6E7C"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnOpen" Style="{StaticResource Btn}" Width="32" Height="30" Padding="0" ToolTip="Abrir macro…">
                  <TextBlock Text="&#xED25;" Style="{StaticResource Glyph}" Margin="0" FontSize="13"/>
                </Button>
                <Button x:Name="BtnSave" Style="{StaticResource Btn}" Width="32" Height="30" Padding="0" Margin="6,0" ToolTip="Guardar macro…">
                  <TextBlock Text="&#xE74E;" Style="{StaticResource Glyph}" Margin="0" FontSize="13"/>
                </Button>
                <Button x:Name="BtnClear" Style="{StaticResource Btn}" Width="32" Height="30" Padding="0" ToolTip="Borrar grabación">
                  <TextBlock Text="&#xE74D;" Style="{StaticResource Glyph}" Margin="0" FontSize="13"/>
                </Button>
              </StackPanel>
            </Grid>
            <Grid Height="150">
              <ListBox x:Name="MacroList" Style="{StaticResource MacroListStyle}"/>
              <TextBlock x:Name="MacroEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                         TextAlignment="Center" Foreground="{StaticResource SubText}" LineHeight="20" IsHitTestVisible="False"/>
            </Grid>
            <CheckBox x:Name="ChkRecordMoves" Style="{StaticResource Switch}" Margin="0,12,0,0"
                      Content="Grabar también el movimiento del ratón"/>
          </StackPanel>
        </Border>

        <Border x:Name="PlaybackCard" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="REPRODUCCIÓN" Style="{StaticResource Caption}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Border Style="{StaticResource SegmentHost}">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="RbMacroCount" GroupName="mrep" Content="Nº de veces" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="RbMacroLoop" GroupName="mrep" Content="En bucle" Style="{StaticResource Segment}"/>
                </UniformGrid>
              </Border>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                <TextBox x:Name="TxtMacroRepeat" Style="{StaticResource NumBox}" Width="90"/>
                <TextBlock Text="veces" Style="{StaticResource FieldLabel}" Margin="8,0,0,0"/>
              </StackPanel>
            </Grid>
            <Grid Margin="0,10,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Velocidad" Style="{StaticResource FieldLabel}"/>
              <Border Grid.Column="1" Style="{StaticResource SegmentHost}">
                <UniformGrid Rows="1">
                  <RadioButton x:Name="RbSpeed05" GroupName="spd" Content="0,5×" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="RbSpeed1" GroupName="spd" Content="1×" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="RbSpeed2" GroupName="spd" Content="2×" Style="{StaticResource Segment}"/>
                  <RadioButton x:Name="RbSpeed4" GroupName="spd" Content="4×" Style="{StaticResource Segment}"/>
                </UniformGrid>
              </Border>
            </Grid>
          </StackPanel>
        </Border>

        <Grid Margin="0,2,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="BtnRecord" Style="{StaticResource DangerBtn}" Height="48">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE7C8;" Style="{StaticResource Glyph}"/>
              <TextBlock x:Name="RecordLabel" Text="Grabar"/>
              <Border Style="{StaticResource KeyBadge}">
                <TextBlock x:Name="RecordKey" FontSize="11"/>
              </Border>
            </StackPanel>
          </Button>
          <Button x:Name="BtnPlay" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Height="48">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}"/>
              <TextBlock Text="Reproducir"/>
              <Border Style="{StaticResource KeyBadge}">
                <TextBlock x:Name="PlayKey" FontSize="11"/>
              </Border>
            </StackPanel>
          </Button>
          <Button x:Name="BtnMacroStop" Grid.Column="4" Style="{StaticResource Btn}" Height="48" Width="48"
                  Padding="0" ToolTip="Detener">
            <TextBlock Text="&#xE71A;" Style="{StaticResource Glyph}" Margin="0"/>
          </Button>
        </Grid>
      </StackPanel>

      <!-- ═════════ Settings ═════════ -->
      <StackPanel x:Name="PanelSettings" Visibility="Hidden">
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="ATAJOS DE TECLADO" Style="{StaticResource Caption}"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Iniciar / detener el clicker" VerticalAlignment="Center"/>
              <Button x:Name="HkClicker" Grid.Column="1" Style="{StaticResource KeyChip}"/>
              <TextBlock Grid.Row="2" Text="Empezar / terminar grabación" VerticalAlignment="Center"/>
              <Button x:Name="HkRecord" Grid.Row="2" Grid.Column="1" Style="{StaticResource KeyChip}"/>
              <TextBlock Grid.Row="4" Text="Reproducir / detener" VerticalAlignment="Center"/>
              <Button x:Name="HkPlay" Grid.Row="4" Grid.Column="1" Style="{StaticResource KeyChip}"/>
            </Grid>
            <TextBlock x:Name="HotkeyHint" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                       Foreground="{StaticResource SubText}"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="VENTANA" Style="{StaticResource Caption}"/>
            <CheckBox x:Name="ChkTopMost" Style="{StaticResource Switch}" Content="Mantener siempre por encima de otras ventanas"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="ACERCA DE" Style="{StaticResource Caption}"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubText}" FontSize="12" LineHeight="19">
              AutoClicker 2.0 · Los clics se envían como clics reales del sistema.
              Para hacer clic en programas abiertos como administrador, abre también AutoClicker como administrador.
            </TextBlock>
            <TextBlock x:Name="DataPath" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="11.5"
                       Foreground="#6E6E7C" FontFamily="Cascadia Mono, Consolas"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Margin="0,12,0,0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1" CornerRadius="10" Padding="14,9">
      <StackPanel Orientation="Horizontal">
        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#6B6B78" VerticalAlignment="Center"/>
        <TextBlock x:Name="StatusText" Margin="10,0,0,0" FontSize="12.5" VerticalAlignment="Center"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
